{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "abdullah.keyboard-layout"
        },
        {
          "id": "abdullah.prayer-times"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "petrzpav.slack",
          "hideWhenRead": true
        },
        {
          "id": "abdullah.system-usage"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "abdullah.desktop-status"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "abdullah.power",
          "showPercentage": true
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "abdullah.keyboard-overlay"
    }
  ],
  "version": 1
}
